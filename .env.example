# ==========================================
# DocMind Environment Variables
# ==========================================

# 1. MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://docmind_user:PASSWORD@cluster0.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="docmind"

# 2. Google Gemini API (Free tier / Pay-as-you-go)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# Model names and dimensions - never hardcoded in application logic
# Check Google Gemini API documentation for the latest versions
EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_DIMS=768
LLM_MODEL="gemini-1.5-flash"

# 3. Vector & Search Indexes (must match the names created in Atlas)
CHUNK_VECTOR_INDEX="chunk_vector_index"
CHUNK_TEXT_INDEX="chunk_text_index"
CACHE_VECTOR_INDEX="cache_vector_index"

# 4. RAG & Semantic Cache Configuration
# Minimum cosine similarity to consider a semantic cache hit (0.0 - 1.0)
SEMANTIC_CACHE_THRESHOLD=0.92

# Minimum retrieval score guardrail threshold
RETRIEVAL_SCORE_THRESHOLD=0.45

# Number of chunks retrieved per search mode
RETRIEVAL_TOP_K=5

# Maximum file upload size in bytes (e.g. 5 MB = 5242880)
MAX_FILE_SIZE_BYTES=5242880

# Maximum documents per anonymous session
MAX_DOCS_PER_SESSION=20

# 5. Application Settings
NEXT_PUBLIC_APP_NAME="DocMind"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
